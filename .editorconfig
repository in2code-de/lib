root = true

[*]
end_of_line = lf
insert_final_newline = true
charset = utf-8
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.php]
indent_size = 4

[*.md]
indent_size = 4

[*.xml]
indent_size = 4
ij_xml_space_inside_empty_tag = false

[Makefile]
indent_style = tab
indent_size = 4

[composer.json]
indent_size = 4
