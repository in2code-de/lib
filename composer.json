{
    "name": "co-stack/lib",
    "type": "library",
    "description": "A set of really useful, well tested and high performant php functions",
    "license": "MIT",
    "authors": [
        {
            "name": "Oliver Eglseder",
            "email": "oliver.eglseder@co-stack.com"
        }
    ],
    "require": {
        "php": "^8.0"
    },
    "require-dev": {
        "ergebnis/composer-normalize": "^2.28",
        "php-parallel-lint/php-parallel-lint": "^1.3",
        "phpmd/phpmd": "^2.12",
        "phpstan/phpstan": "^1.8",
        "phpunit/phpunit": "^9.5",
        "squizlabs/php_codesniffer": "^3.7",
        "vimeo/psalm": "^4.26",
        "infection/infection": "^0.26.14",
        "jetbrains/phpstorm-attributes": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "CoStack\\Lib\\": "src"
        },
        "files": [
            "funcs/cos_lib_funcs.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "CoStack\\LibTests\\": "tests"
        }
    },
    "scripts": {
        "qa-all": [
            "@qa-composer",
            "@qa-lint",
            "@qa-phpcs",
            "@qa-phpmd",
            "@qa-phpstan",
            "@qa-psalm",
            "@qa-phpunit",
            "@qa-infection"
        ],
        "qa-composer": "composer validate --no-check-lock",
        "qa-lint": "vendor/bin/parallel-lint src tests",
        "qa-phpcs": "vendor/bin/phpcs",
        "qa-phpmd": "vendor/bin/phpmd src,tests ansi .phpmd.xml",
        "qa-phpstan": "vendor/bin/phpstan analyse -c .phpstan.neon",
        "qa-phpunit": "vendor/bin/phpunit -c .phpunit.xml",
        "qa-phpunit-coverage": "XDEBUG_MODE=coverage vendor/bin/phpunit -c .phpunit.xml --coverage-text --colors=never",
        "qa-psalm": "vendor/bin/psalm -c .psalm.xml",
        "qa-infection": "XDEBUG_MODE=coverage vendor/bin/infection --configuration=.infection.json -j$(nproc) --min-covered-msi=100 --min-msi=100"
    },
    "config": {
        "allow-plugins": {
            "infection/extension-installer": true,
            "ergebnis/composer-normalize": true
        }
    }
}
